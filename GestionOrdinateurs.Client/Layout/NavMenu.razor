@inject ISessionStorageService SessionStorage
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<header class="site-header">
    <div class="header-content">
        <a class="site-title" href="">Parc informatique</a>
        <nav class="site-nav" aria-label="Navigation principale">
            <NavLink href="" Match="NavLinkMatch.All">Accueil</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink href="ordinateurs">Ordinateurs</NavLink>
                    <AuthorizeView Roles="Admin" Context="adminCtx">
                        <NavLink href="reparations">Réparations</NavLink>
                    </AuthorizeView>
                    <span class="session-user">
                        @context.User.Identity?.Name · @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                    </span>
                    <button class="logout-button" @onclick="DeconnecterAsync">Déconnexion</button>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="login">Connexion</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    private async Task DeconnecterAsync()
    {
        await SessionStorage.RemoveItemAsync("jwtToken");
        AuthProvider.NotifyUserLogout();
        Navigation.NavigateTo("/");
    }
}
