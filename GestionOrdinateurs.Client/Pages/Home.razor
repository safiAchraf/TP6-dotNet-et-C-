@page "/"

<PageTitle>Accueil</PageTitle>

<h1>Parc informatique</h1>
<p class="page-intro">Consultation des ordinateurs et suivi des réparations de l'atelier.</p>

<AuthorizeView>
    <Authorized>
        <p class="session-note">
            Session : <strong>@context.User.Identity?.Name</strong> · @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
        </p>
        <h2>Accès aux rubriques</h2>
        <ul class="home-links">
            <li><a href="ordinateurs">Liste des ordinateurs</a></li>
            <AuthorizeView Roles="Admin" Context="adminCtx">
                <li><a href="reparations">Historique des réparations</a></li>
            </AuthorizeView>
        </ul>
    </Authorized>
    <NotAuthorized>
        <p class="session-note">Veuillez vous <a href="login">connecter</a> pour accéder aux ordinateurs.</p>
    </NotAuthorized>
</AuthorizeView>
