{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "http": {
        "Url": "http://0.0.0.0:5010"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "route-ordinateurs": {
        "ClusterId": "gestionOrdinateursAPI",
        "Match": {
          "Path": "/api/ordinateurs/{**catch-all}"
        }
      },
      "route-reparations": {
        "ClusterId": "gestionOrdinateursAPI",
        "Match": {
          "Path": "/api/reparations/{**catch-all}"
        }
      },
      "route-reparation": {
        "ClusterId": "gestionOrdinateursAPI",
        "Match": {
          "Path": "/api/reparation/{**catch-all}"
        }
      },
      "route-auth": {
        "ClusterId": "authentificationAPI",
        "Match": {
          "Path": "/api/authentication/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestionOrdinateursAPI": {
        "Destinations": {
          "apiService": {
            "Address": "http://gestionordinateurs-api:5247/"
          }
        }
      },
      "authentificationAPI": {
        "Destinations": {
          "authService": {
            "Address": "http://authentification-api:5250/"
          }
        }
      }
    }
  }
}
